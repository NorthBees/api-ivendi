{
    "name": "northbees/ivendi-api",
    "description": "A Laravel SDK for the iVendi Connect API - quote configuration, finance quotes, payment search and representative examples.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Steve Smith",
            "email": "steven@sd-smith.co.uk",
            "homepage": "https://github.com/NorthBees/"
        }
    ],
    "homepage": "https://github.com/northbees/api-ivendi",
    "keywords": [
        "laravel",
        "ivendi",
        "finance",
        "vehicle-finance",
        "hire-purchase",
        "pcp",
        "sdk"
    ],
    "support": {
        "issues": "https://github.com/northbees/api-ivendi/issues",
        "source": "https://github.com/northbees/api-ivendi"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "pestphp/pest": "^4.4.2",
        "pestphp/pest-plugin-laravel": "^4.1",
        "laravel/pint": "^1.29",
        "larastan/larastan": "^3.9.3",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "NorthBees\\IvendiApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NorthBees\\IvendiApi\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NorthBees\\IvendiApi\\IvendiServiceProvider"
            ],
            "aliases": {
                "Ivendi": "NorthBees\\IvendiApi\\Facades\\Ivendi"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
